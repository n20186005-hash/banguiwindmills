---
import { mapsUrl } from '../config';

const { t } = Astro.props;
---

<section
  id="hero"
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src="/gallery/bangui-windmills-5.jpg"
      alt={t.hero.heroAlt}
      class="h-full w-full object-cover"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <!-- Overlay gradients -->
    <div class="absolute inset-0 bg-gradient-to-b from-navy/60 via-navy/30 to-navy/70"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <!-- Windmill Icon -->
    <div class="mb-8 inline-flex animate-fade-up">
      <img
        src="/favicon.svg"
        alt=""
        class="h-20 w-20 animate-spin-slow opacity-90"
        width="80"
        height="80"
      />
    </div>

    <h1 class="animate-fade-up text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl" style="animation-delay: 0.15s">
      {t.hero.title}
    </h1>

    <p class="mx-auto mt-6 max-w-2xl animate-fade-up text-lg leading-relaxed text-white/80 sm:text-xl" style="animation-delay: 0.3s">
      {t.hero.subtitle}
    </p>

    <!-- Stats row -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-6 animate-fade-up sm:gap-10" style="animation-delay: 0.45s">
      <div class="text-center">
        <div class="text-3xl font-bold text-gold sm:text-4xl">{t.hero.rating}</div>
        <div class="mt-1 flex items-center justify-center gap-0.5">
          {Array.from({ length: 5 }, () => (
            <svg class="h-4 w-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <div class="mt-0.5 text-sm text-white/60">{t.hero.reviews} {t.hero.reviewsSuffix}</div>
        <div class="mt-1 max-w-xs text-center text-xs text-white/50">
          {t.reviews.sourceNote}
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-white/40 underline-offset-2 transition-colors hover:text-white"
          >
            {t.reviews.sourceLink}
          </a>
        </div>
      </div>

      {t.hero.facts.map((fact: { k: string; v: string }) => (
        <>
          <div class="h-10 w-px bg-white/20 hidden sm:block"></div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white sm:text-4xl">{fact.v}</div>
            <div class="mt-1 text-sm text-white/60">{fact.k}</div>
          </div>
        </>
      ))}
    </div>

    <!-- CTA Buttons -->
    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center animate-fade-up" style="animation-delay: 0.6s">
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 text-sm font-semibold text-navy shadow-lg transition-all hover:bg-gold-light hover:shadow-xl"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {t.hero.ctaMaps}
      </a>
      <a
        href="#introduction"
        class="inline-flex items-center gap-2 rounded-full border-2 border-white/30 px-8 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:border-white/60 hover:bg-white/10"
      >
        {t.hero.ctaExplore}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="h-6 w-6 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
    </svg>
  </div>
</section>
