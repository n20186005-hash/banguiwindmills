---
const { t } = Astro.props;
---

<section id="history" class="section-alt">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12 text-center">
      <span class="badge">{t.history.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        {t.history.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone leading-relaxed">
        {t.history.subtitle}
      </p>
    </div>

    <!-- Timeline -->
    <div class="reveal mx-auto max-w-3xl">
      <div class="relative border-l-2 border-sky-light pl-8 space-y-10">
        {t.history.sections.map((section: { era: string; heading: string; body: string }, idx: number) => {
          const isToday = idx === t.history.sections.length - 1;
          return (
            <div class="relative">
              <div class={`absolute -left-[2.15rem] top-1.5 h-4 w-4 rounded-full ring-4 ring-turbine ${isToday ? 'bg-green' : 'bg-ocean'}`}></div>
              <time class={`text-sm font-semibold uppercase tracking-wider ${isToday ? 'text-green' : 'text-ocean'}`}>{section.era}</time>
              <h3 class="mt-1 text-xl font-bold text-navy">{section.heading}</h3>
              <p class="mt-2 text-stone leading-relaxed" set:html={section.body} />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
