---
const { t } = Astro.props;
---

<section id="parking" class="section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="reveal mb-12 text-center">
      <span class="badge">{t.parking.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        {t.parking.title}
      </h2>
    </div>

    <div class="reveal mx-auto max-w-3xl">
      <div class="card p-8">
        <div class="mb-6 flex items-center gap-4">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ocean/10">
            <svg class="h-7 w-7 text-ocean" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-navy">On-Site Parking</h3>
            <p class="text-sm text-green font-medium">Free Roadside Parking</p>
          </div>
        </div>

        <div class="space-y-4 text-stone leading-relaxed">
          <p>
            {t.parking.overview} Visitors can pull over along the roadside adjacent to the viewing area. The
            road runs parallel to the shoreline, so you'll have a place to park wherever
            you stop along the 9-kilometer turbine stretch.
          </p>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl bg-turbine/50 p-4">
              <h4 class="font-semibold text-navy">Parking Type</h4>
              <p class="mt-1 text-sm">Roadside pull-off along the national highway. No designated parking lot — park on the shoulder facing the turbines.</p>
            </div>
            <div class="rounded-xl bg-turbine/50 p-4">
              <h4 class="font-semibold text-navy">Vehicle Size</h4>
              <p class="mt-1 text-sm">Suitable for cars, vans, motorcycles, and even tour buses. The road shoulder is wide enough for most vehicles.</p>
            </div>
            <div class="rounded-xl bg-turbine/50 p-4">
              <h4 class="font-semibold text-navy">Safety Note</h4>
              <p class="mt-1 text-sm">Park well off the road. Watch for passing vehicles when crossing. The national highway can have moderate traffic, especially during peak tourist season.</p>
            </div>
            <div class="rounded-xl bg-turbine/50 p-4">
              <h4 class="font-semibold text-navy">Best Spot</h4>
              <p class="mt-1 text-sm">The area near the central cluster of turbines offers the best photo angles. Souvenir stalls and empanada vendors are usually found here too.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
