---
import { attraction, mapsUrl } from '../config';
const { t, lang } = Astro.props;
---

<footer class="bg-navy text-white/70">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <img
            src="/favicon.svg"
            alt=""
            class="h-8 w-8 invert animate-spin-slow"
            width="32"
            height="32"
          />
          <span class="text-lg font-semibold text-white">{attraction.name}</span>
        </div>
        <p class="text-sm leading-relaxed">
          A landmark of sustainable energy and natural beauty on the shores of Bangui Bay,
          Ilocos Norte — where the wind powers both the land and the imagination.
        </p>
        <div class="pt-2 border-t border-white/10">
          <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-white/90">{t.footer.missionTitle}</h4>
          <p class="text-xs leading-relaxed text-white/50">
            {t.footer.missionText}
          </p>
        </div>
      </div>

      <!-- Quick Links / Explore -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white/90">{t.footer.exploreTitle}</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#introduction" class="transition-colors hover:text-gold">{t.header.intro}</a></li>
          <li><a href="#history" class="transition-colors hover:text-gold">{t.header.history}</a></li>
          <li><a href="#entrance-fee" class="transition-colors hover:text-gold">{t.header.entranceFee}</a></li>
          <li><a href="#transport" class="transition-colors hover:text-gold">{t.header.transport}</a></li>
          <li><a href="#gallery" class="transition-colors hover:text-gold">{t.header.gallery}</a></li>
          <li><a href="#faq" class="transition-colors hover:text-gold">{t.header.faq}</a></li>
        </ul>
      </div>

      <!-- Contact / Map -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white/90">{t.footer.visitTitle}</h3>
        <div class="space-y-3 text-sm">
          <p>{t.footer.addressValue}</p>
          <p class="font-mono text-white/50">{attraction.plusCode}</p>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-gold transition-colors hover:text-gold-light"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            {t.footer.mapsLabel}
          </a>
        </div>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white/90">{t.footer.resourcesTitle}</h3>
        <ul class="space-y-2.5 text-sm">
          {t.footer.resources.map((res) => (
            <li>
              <a
                href={res.url}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-gold inline-flex items-center gap-1.5"
              >
                <svg class="h-3.5 w-3.5 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                {res.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="mt-12 border-t border-white/10 pt-8 text-center text-xs text-white/40">
      <p>{t.footer.disclaimer}</p>
    </div>
  </div>
</footer>
