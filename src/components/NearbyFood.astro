---
const { t } = Astro.props;
---

<section id="nearby-food" class="section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12 text-center">
      <span class="badge">{t.nearbyFood.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        {t.nearbyFood.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone leading-relaxed">
        {t.nearbyFood.subtitle}
      </p>
    </div>

    <!-- Must-Try Local -->
    <div class="reveal mx-auto mb-10 max-w-3xl rounded-2xl bg-gradient-to-r from-gold-light/20 to-gold-light/5 p-6 sm:p-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-4xl">🥟</span>
        <div>
          <h3 class="text-xl font-bold text-navy">Must Try: Ilocos Empanada</h3>
          <p class="text-sm text-stone">The Iconic Street Food of Ilocos Norte</p>
        </div>
      </div>
      <p class="text-stone leading-relaxed">
        No trip to Bangui is complete without sampling the famous <strong>Ilocos
        Empanada</strong> — a deep-fried orange pastry stuffed with grated green papaya,
        longganisa (local sausage), and a whole egg. Vendors selling fresh empanada
        are often found near the central viewing area. Price: <strong>PHP 40–70</strong> each.
      </p>
    </div>

    <!-- Restaurant Cards -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.nearbyFood.spots.map((spot, i) => (
        <div class="reveal card p-6" style={`animation-delay: ${i * 0.1}s`}>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🍽️</span>
            <div class="flex-1">
              <h4 class="font-bold text-navy">{spot.name}</h4>
              <span class="text-xs text-stone/60">{spot.distance}</span>
            </div>
          </div>
          <p class="text-sm text-stone leading-relaxed">{spot.desc}</p>
        </div>
      ))}
    </div>

    <div class="reveal mt-10 text-center text-xs text-stone/60">
      <p>{t.nearbyFood.note}</p>
    </div>
  </div>
</section>
