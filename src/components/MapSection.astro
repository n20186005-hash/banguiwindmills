---
import { attraction, mapsUrl } from '../config';
const { t } = Astro.props;
---

<section id="map-section" class="section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12 text-center">
      <span class="badge">{t.map.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        {t.map.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone leading-relaxed">
        {t.map.subtitle}
      </p>
    </div>

    <div class="reveal map-container mx-auto max-w-4xl shadow-lg">
      <iframe
        src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3803.926588422!2d120.7155353!3d18.5285706!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3389254c5574a46d%3A0xf1e2525a3b963752!2sBangui%20Windmills!5e0!3m2!1sen!2sph!4v1690000000000!5m2!1sen!2sph`}
        title="Bangui Windmills — Google Maps"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="reveal mt-8 text-center">
      <div class="inline-flex flex-wrap items-center justify-center gap-4 rounded-2xl bg-turbine/50 px-6 py-4">
        <div class="text-sm text-stone">
          <strong class="text-navy">{t.map.addressLabel}:</strong> {t.map.addressValue}
        </div>
        <div class="hidden sm:block h-6 w-px bg-stone/30"></div>
        <div class="text-sm text-stone">
          <strong class="text-navy">{t.map.hoursLabel}:</strong> {t.map.hoursValue}
        </div>
        <div class="hidden sm:block h-6 w-px bg-stone/30"></div>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-ocean hover:underline inline-flex items-center gap-1"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          {t.map.openLabel}
        </a>
      </div>
    </div>
  </div>
</section>
