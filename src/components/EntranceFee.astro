---
const { t } = Astro.props;
---

<section id="entrance-fee" class="section-alt">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12 text-center">
      <span class="badge">{t.entranceFee.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        {t.entranceFee.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone leading-relaxed">
        {t.entranceFee.subtitle}
      </p>
    </div>

    <div class="reveal mx-auto max-w-3xl">
      <!-- Free admission card -->
      <div class="card overflow-hidden">
        <div class="bg-green p-6 text-center text-white">
          <div class="text-6xl font-extrabold">FREE</div>
          <div class="mt-2 text-lg font-medium text-white/90">{t.entranceFee.priceNote}</div>
        </div>
        <div class="p-6 sm:p-8 space-y-4">
          <p class="text-stone leading-relaxed">
            {t.entranceFee.subtitle} The Bangui Windmills viewing area along the shoreline is <strong class="text-green">completely free</strong>
            and open to the public 24 hours a day, 7 days a week. There are no gates,
            no ticket booths, and no admission charges whatsoever.
          </p>
          <div class="rounded-xl bg-turbine/50 p-5">
            <h4 class="font-semibold text-navy">What's Included (Free Access)</h4>
            <ul class="mt-3 space-y-2 text-sm text-stone">
              {t.entranceFee.included.map((item) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-xl border border-sky-light/50 bg-sky-light/20 p-5">
            <h4 class="font-semibold text-navy">Possible Expenses</h4>
            <ul class="mt-3 space-y-2 text-sm text-stone">
              {t.entranceFee.possibleExpenses.map((item) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-ocean" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
