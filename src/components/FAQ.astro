---
const { t } = Astro.props;
const faqs: { q: string; a: string }[] = t.faq.items;

// 在 frontmatter 构建 JSON-LD：is:inline 的 <script> 不会解析模板表达式，
// 必须改用 set:html 输出，否则结构数据会是无效 JSON。
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<section id="faq" class="section-alt">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12 text-center">
      <span class="badge">{t.faq.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        {t.faq.title}
      </h2>
    </div>

    <div class="reveal space-y-3">
      {faqs.map((faq, _i) => (
        <div class="faq-item rounded-xl bg-white shadow-sm border border-turbine/50 overflow-hidden">
          <h3 class="m-0 text-base font-semibold">
            <button
              class="faq-trigger flex w-full items-center justify-between px-6 py-4 text-left font-semibold text-navy hover:bg-turbine/30 transition-colors"
              aria-expanded="false"
            >
              <span>{faq.q}</span>
              <svg
                class="faq-icon h-5 w-5 flex-shrink-0 text-stone transition-transform duration-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </h3>
          <div class="faq-answer">
            <div class="px-6 pb-5 text-stone leading-relaxed text-sm">
              {faq.a}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQPage Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script is:inline>
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('.faq-icon');
      const isOpen = answer?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!isOpen));
      if (isOpen) {
        icon?.classList.add('rotate-180');
      } else {
        icon?.classList.remove('rotate-180');
      }
    });
  });
</script>
