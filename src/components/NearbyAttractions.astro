---
const { t } = Astro.props;
---

<section id="nearby-attractions" class="section-alt">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12 text-center">
      <span class="badge">{t.nearby.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        {t.nearby.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone leading-relaxed">
        {t.nearby.subtitle}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.nearby.spots.map((place, i) => (
        <div class="reveal card overflow-hidden group" style={`animation-delay: ${i * 0.1}s`}>
          <div class="p-6">
            <div class="flex items-start justify-between mb-3">
              <h4 class="text-lg font-bold text-navy group-hover:text-ocean transition-colors">
                {place.name}
              </h4>
              <span class="badge flex-shrink-0 ml-2 text-xs">{place.distance}</span>
            </div>
            <p class="text-sm text-stone leading-relaxed">{place.desc}</p>
            <div class="mt-4 flex items-center gap-2 text-xs">
              <svg class="h-3.5 w-3.5 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              <span class="text-stone/70">{place.icon}</span>
            </div>
          </div>
          <div class="h-1 w-full bg-gradient-to-r from-ocean via-sky-light to-green opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      ))}
    </div>

    <div class="reveal mt-16 mx-auto max-w-4xl rounded-2xl bg-white shadow-sm border border-turbine/30 overflow-hidden">
      <div class="bg-gradient-to-r from-navy to-ocean px-6 py-5 sm:px-8 sm:py-6">
        <h3 class="text-xl font-bold text-white">{t.nearby.route.title}</h3>
        <p class="mt-2 text-sm text-white/80 leading-relaxed">{t.nearby.route.intro}</p>
      </div>
      <div class="p-6 sm:p-8">
        <ol class="relative border-l-2 border-ocean/20 ml-3 space-y-6">
          {t.nearby.route.steps.map((step, i) => (
            <li class="ml-6" style={`animation-delay: ${i * 0.05}s`}>
              <span class="absolute -left-[11px] flex h-5 w-5 items-center justify-center rounded-full bg-ocean text-white text-xs font-bold ring-4 ring-white">
                {i + 1}
              </span>
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                <div>
                  <h4 class="font-semibold text-navy">{step.place}</h4>
                  <p class="mt-1 text-sm text-stone leading-relaxed">{step.note}</p>
                </div>
                <span class="badge flex-shrink-0 text-xs whitespace-nowrap">
                  <svg class="h-3 w-3 inline mr-1 -mt-0.5 text-gold" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  {step.time}
                </span>
              </div>
            </li>
          ))}
        </ol>
        <div class="mt-8 rounded-xl bg-turbine/40 px-5 py-4 text-sm text-stone/80 leading-relaxed">
          <p>💡 {t.nearby.route.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>
