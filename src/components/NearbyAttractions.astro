---
interface NearbyPlace {
  name: string;
  description: string;
  distance: string;
  highlight: string;
}

const nearby: NearbyPlace[] = [
  {
    name: 'Kapurpurawan Rock Formation',
    description:
      'A stunning white limestone rock formation sculpted by wind and waves over millennia. Located on the rocky coast of Burgos, this geological wonder is a favorite for photographers — especially at sunset.',
    distance: '~15 km',
    highlight: 'White rock landscape',
  },
  {
    name: 'Cape Bojeador Lighthouse',
    description:
      'Also known as Burgos Lighthouse, this Spanish colonial-era lighthouse was built in 1892 and still operates today. Climb to the top for panoramic views of the West Philippine Sea.',
    distance: '~12 km',
    highlight: 'Spanish colonial heritage',
  },
  {
    name: 'Patapat Viaduct',
    description:
      'A 1.3-kilometer coastal bridge that snakes along the mountainside at the northern tip of Luzon. Often called the "French Riviera of the Philippines" for its dramatic seaside scenery.',
    distance: '~30 km',
    highlight: 'Scenic coastal drive',
  },
  {
    name: 'Saud Beach (Pagudpud)',
    description:
      'Consistently ranked among the Philippines\' best beaches, Saud Beach boasts powdery white sand, crystal-clear turquoise water, and a peaceful atmosphere. Ideal for swimming and relaxing after a day of sightseeing.',
    distance: '~25 km',
    highlight: 'White sand & turquoise water',
  },
  {
    name: 'Kabigan Falls',
    description:
      'A refreshing 80-foot waterfall tucked in the forests of Pagudpud. Accessible via a scenic 1.5-kilometer trek (guide required). The cool natural pool at the base is perfect for a refreshing dip.',
    distance: '~28 km',
    highlight: 'Trek & waterfall swim',
  },
  {
    name: 'Burgos Wind Farm',
    description:
      'The largest wind farm in the Philippines with 50 turbines, located in the neighboring town of Burgos. Less touristy than Bangui, offering a different perspective on Ilocos Norte\'s wind energy landscape.',
    distance: '~10 km',
    highlight: 'Largest wind farm in PH',
  },
];
---

<section id="nearby-attractions" class="section-alt">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12 text-center">
      <span class="badge">Explore More</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy sm:text-4xl">
        Nearby Attractions
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone leading-relaxed">
        Bangui Windmills sits at the heart of Ilocos Norte's most scenic coastal route.
        Make a day of it — these 6 must-visit spots are all within easy driving distance.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {nearby.map((place, i) => (
        <div class="reveal card overflow-hidden group" style={`animation-delay: ${i * 0.1}s`}>
          <div class="p-6">
            <div class="flex items-start justify-between mb-3">
              <h4 class="text-lg font-bold text-navy group-hover:text-ocean transition-colors">
                {place.name}
              </h4>
              <span class="badge flex-shrink-0 ml-2 text-xs">{place.distance}</span>
            </div>
            <p class="text-sm text-stone leading-relaxed">{place.description}</p>
            <div class="mt-4 flex items-center gap-2 text-xs">
              <svg class="h-3.5 w-3.5 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              <span class="text-stone/70">{place.highlight}</span>
            </div>
          </div>
          <div class="h-1 w-full bg-gradient-to-r from-ocean via-sky-light to-green opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      ))}
    </div>
  </div>
</section>
