---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Introduction from '../components/Introduction.astro';
import History from '../components/History.astro';
import BestTime from '../components/BestTime.astro';
import EntranceFee from '../components/EntranceFee.astro';
import Parking from '../components/Parking.astro';
import Transport from '../components/Transport.astro';
import NearbyFood from '../components/NearbyFood.astro';
import NearbyAttractions from '../components/NearbyAttractions.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import MapSection from '../components/MapSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Introduction />
    <History />
    <BestTime />
    <EntranceFee />
    <Parking />
    <Transport />
    <NearbyFood />
    <NearbyAttractions />
    <Gallery />
    <FAQ />
    <MapSection />
  </main>
  <Footer />
</BaseLayout>
