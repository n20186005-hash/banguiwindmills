---
import fil from '../i18n/fil.json';
const t = fil;
const lang = 'fil';

import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Introduction from '../components/Introduction.astro';
import History from '../components/History.astro';
import BestTime from '../components/BestTime.astro';
import EntranceFee from '../components/EntranceFee.astro';
import Parking from '../components/Parking.astro';
import Transport from '../components/Transport.astro';
import NearbyFood from '../components/NearbyFood.astro';
import NearbyAttractions from '../components/NearbyAttractions.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import MapSection from '../components/MapSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout t={t} lang={lang}>
  <Header t={t} lang={lang} />
  <main>
    <Hero t={t} />
    <Introduction t={t} />
    <History t={t} />
    <BestTime t={t} />
    <EntranceFee t={t} />
    <Parking t={t} />
    <Transport t={t} />
    <NearbyFood t={t} />
    <NearbyAttractions t={t} />
    <Gallery t={t} />
    <FAQ t={t} />
    <MapSection t={t} />
  </main>
  <Footer t={t} lang={lang} />
</BaseLayout>
