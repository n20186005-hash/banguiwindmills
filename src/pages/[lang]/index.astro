---
export function getStaticPaths() {
  const ALL_LANGS = ['en', 'zh', 'fil', 'km'];
  return ALL_LANGS.map((lang) => ({ params: { lang } }));
}
const destination = '/';
---
<meta http-equiv="refresh" content={`0;url=${destination}`} />
<script is:inline>window.location.href = '/';</script>
<p>Redirecting to <a href="/">Bangui Windmills</a>...</p>
