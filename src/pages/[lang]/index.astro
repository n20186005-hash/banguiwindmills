---
import en from '../../i18n/en.json';
import zh from '../../i18n/zh.json';
import fil from '../../i18n/fil.json';

export function getStaticPaths() {
  return ['en', 'zh', 'fil', 'km'].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (lang === 'km') {
  return Astro.redirect('/fil/', 301);
}

const LANG_MAP = { en, zh, fil };
const t = LANG_MAP[lang as 'en' | 'zh' | 'fil'];
const currentLang = lang as 'en' | 'zh' | 'fil';

import BaseLayout from '../../components/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Introduction from '../../components/Introduction.astro';
import History from '../../components/History.astro';
import BestTime from '../../components/BestTime.astro';
import Weather from '../../components/Weather.astro';
import EntranceFee from '../../components/EntranceFee.astro';
import Parking from '../../components/Parking.astro';
import Transport from '../../components/Transport.astro';
import TransportGuide from '../../components/TransportGuide.astro';
import NearbyFood from '../../components/NearbyFood.astro';
import Amenities from '../../components/Amenities.astro';
import NearbyAttractions from '../../components/NearbyAttractions.astro';
import SeasonalStrategy from '../../components/SeasonalStrategy.astro';
import Itineraries from '../../components/Itineraries.astro';
import Responsibility from '../../components/Responsibility.astro';
import Gallery from '../../components/Gallery.astro';
import FAQ from '../../components/FAQ.astro';
import Sources from '../../components/Sources.astro';
import MapSection from '../../components/MapSection.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  t={t}
  lang={currentLang}
  pagePath={`/${currentLang}/`}
  preloadImage="/gallery/bangui-windmills-5.jpg"
>
  <Header t={t} lang={currentLang} />
  <main>
    <Hero t={t} />
    <Introduction t={t} />
    <History t={t} />
    <BestTime t={t} />
    <Weather t={t} lang={currentLang} />
    <EntranceFee t={t} />
    <Parking t={t} />
    <Transport t={t} />
    <TransportGuide t={t} />
    <NearbyFood t={t} />
    <Amenities t={t} />
    <NearbyAttractions t={t} />
    <SeasonalStrategy t={t} />
    <Itineraries t={t} />
    <Responsibility t={t} />
    <Gallery t={t} />
    <FAQ t={t} />
    <Sources t={t} />
    <MapSection t={t} />
  </main>
  <Footer t={t} lang={currentLang} />
</BaseLayout>
