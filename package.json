{
  "name": "bangui-windmills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && cross-env CURRENT_SITE_DOMAIN=banguiwindmills.com wrangler deploy",
    "deploy": "npm run cf:deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "cross-env": "7.0.3",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  }
}
